# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Render production URL (used when VITE_API_BASE_URL is not set)
VITE_API_BASE_URL=https://hooksdream-rjwo.onrender.com

# Google OAuth
# ⚠️ BẮT BUỘC phải trùng với GOOGLE_CLIENT_ID của backend,
# nếu không backend sẽ verify id_token sai audience và login thất bại.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Push Notifications - phải trùng VAPID_PUBLIC_KEY của backend
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# App Configuration
VITE_APP_NAME=HooksDream
VITE_APP_VERSION=1.0.0

# Optional: Analytics
# VITE_GA_TRACKING_ID=your_google_analytics_id

# Optional: Sentry (Error Tracking)
# VITE_SENTRY_DSN=your_sentry_dsn

# Optional: Feature Flags
# VITE_ENABLE_DARK_MODE=true
# VITE_ENABLE_ANALYTICS=false

# Optional: External APIs
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_key
# VITE_MAPBOX_TOKEN=your_mapbox_token

# Environment
VITE_NODE_ENV=development