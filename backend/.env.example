# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/hooksdream

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRY=7d

# Google OAuth - BẮT BUỘC (server sẽ crash nếu thiếu).
# ⚠️ Phải trùng với VITE_GOOGLE_CLIENT_ID của frontend, nếu không
# verifyIdToken() sai audience và đăng nhập thất bại.
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary (Media Upload)
CLOUDINARY_URL=cloudinary://your_cloud_name:your_api_key@your_cloud_name

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:5173
# Danh sách origin được phép cho server.js, ngăn cách bằng dấu phẩy.
# Dùng để môi trường deploy mà không cần sửa code.
FRONTEND_URLS=https://hooksdream.vercel.app,http://localhost:5173

# Push Notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
# ⚠️ PRIVATE KEY - chỉ đặt ở server/Render, KHÔNG bao giờ commit.
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional: Email Service (if implemented)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100